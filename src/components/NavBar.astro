---
import Emblem from "./Emblem.astro";
import Motif from "./Motif.astro";

const links = [
    { href: "/", label: "Browse" },
    { href: "/about", label: "About Sabato Morais" },
    { href: "/about#repository", label: "The Repository" },
    { href: "/methodology", label: "Methodology" },
    { href: "/acknowledgements", label: "Acknowledgements" },
];
---

<!-- Navy top band -->
<div class="h-1.5 w-full bg-navy"></div>

<header class="border-b border-border bg-paper-light">
    <div class="mx-auto max-w-screen-xl px-4 py-7 text-center">
        <p class="eyebrow mb-4">Judaica Digital Humanities at Penn</p>

        <a href="/" class="inline-flex flex-col items-center">
            <Emblem size={64} />
            <h1 class="mt-3 font-heading text-4xl leading-none tracking-wide text-navy sm:text-5xl md:text-6xl">
                Sabato Morais
            </h1>
            <p class="mt-1 font-heading text-lg italic text-burgundy sm:text-xl">
                Digital Repository
            </p>
        </a>

        <div class="ornament mx-auto mt-5 max-w-md">
            <Motif class="text-gold" size={20} />
        </div>

        <!-- Navigation -->
        <nav class="mt-4">
            <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-sans text-sm">
                {links.map((link, i) => (
                    <>
                        {i > 0 && <li aria-hidden="true" class="text-gold-soft">&#10022;</li>}
                        <li>
                            <a
                                href={link.href}
                                class="uppercase tracking-widest text-navy/80 transition-colors hover:text-burgundy"
                            >
                                {link.label}
                            </a>
                        </li>
                    </>
                ))}
            </ul>
        </nav>
    </div>
</header>

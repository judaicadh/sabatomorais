---
import BaseLayout from "../layouts/BaseLayout.astro";
import Motif from "../components/Motif.astro";

// People who transcribed Morais's writings and correspondence.
const transcribers = [
  { name: "Alessia Fontanella", role: "PhD student, Bar-Ilan University" },
  { name: "Alice Avanzi", role: "Independent researcher" },
  { name: "Camilla Berveglieri", role: "Master's student, Venice" },
  { name: "Donatella Fischer", role: "Independent researcher" },
  { name: "Martina Perotta", role: "PhD student, Trento" },
  { name: "Pia Settimi", role: "Independent researcher" },
];

// Contributors who reviewed transcriptions (crowdsourcing usernames).
const reviewers = [
  "LIFrancophone",
  "sabern",
  "AFontanella",
  "Alice A.T.",
  "MaryV",
  "glnite",
  "Steviedog",
  "sofiaglynne",
  "txblaize",
];

const partners = [
  "Penn Libraries",
  "Congregation Mikveh Israel",
  "The Jewish Theological Seminary",
];
---

<BaseLayout
  title="Acknowledgements"
  description="The people, institutions, and funders behind the Sabato Morais Digital Repository."
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:py-20">
    <header class="mb-12 text-center">
      <p class="eyebrow mb-3">With Gratitude</p>
      <h1 class="font-heading text-4xl leading-tight text-navy sm:text-5xl">
        Acknowledgements
      </h1>
      <div class="ornament mx-auto mt-6 max-w-sm">
        <Motif class="text-gold" size={20} />
      </div>
    </header>

    <div class="prose prose-neutral max-w-none font-body text-lg text-ink prose-headings:font-heading prose-headings:text-navy prose-a:text-burgundy prose-strong:text-ink">
      <p>
        The <strong>Sabato Morais Digital Repository</strong> is the work of many
        hands. We are grateful to the individuals and institutions whose scholarship,
        care, and generosity made this collection possible.
      </p>
    </div>

    <!-- Transcription team -->
    <div class="mt-12 space-y-10">
      <section class="frame-gold rounded-sm bg-card p-7 sm:p-8">
        <h2 class="mb-1 font-heading text-2xl text-navy">Transcription</h2>
        <p class="mb-5 font-sans text-sm text-ink-muted">
          Scholars who transcribed Morais's writings and correspondence.
        </p>
        <ul class="space-y-3">
          {transcribers.map((person) => (
            <li class="flex items-baseline gap-3 font-body text-lg text-ink">
              <Motif class="shrink-0 translate-y-1 text-gold" size={13} />
              <span>
                {person.name}
                {person.role && (
                  <span class="block font-sans text-sm text-ink-muted">{person.role}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="frame-gold rounded-sm bg-card p-7 sm:p-8">
        <h2 class="mb-1 font-heading text-2xl text-navy">Review</h2>
        <p class="mb-5 font-sans text-sm text-ink-muted">
          Contributors who reviewed and corrected transcriptions.
        </p>
        <ul class="flex flex-wrap gap-2">
          {reviewers.map((name) => (
            <li class="rounded-full border border-border bg-paper-light px-4 py-1.5 font-sans text-sm text-ink">
              {name}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <!-- Partners -->
    <div class="mt-12">
      <p class="eyebrow mb-3">Partner Institutions</p>
      <ul class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
        {partners.map((p) => (
          <li class="border-b border-border py-2 font-body text-lg text-ink">{p}</li>
        ))}
      </ul>
    </div>

    <!-- Rights note -->
    <div class="mt-14 border-t border-border pt-8 text-center">
      <div class="ornament mx-auto mb-6 max-w-xs">
        <Motif class="text-gold" size={16} />
      </div>
      <p class="mx-auto max-w-2xl font-body text-base leading-relaxed text-ink-muted">
        Materials are reproduced with the permission of the holding institutions.
        For questions about rights and reuse, or to suggest a correction, please
        contact
        <a href="https://judaicadhpenn.org/" class="text-burgundy underline">Judaica Digital Humanities at Penn</a>.
      </p>
    </div>
  </article>
</BaseLayout>

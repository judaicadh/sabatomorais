---
import Motif from "./Motif.astro";
---

<footer class="mt-20 bg-navy text-accent-50">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center">
        <div class="ornament mx-auto mb-8 max-w-xs">
            <Motif class="text-gold-soft" size={22} />
        </div>

        <h2 class="font-heading text-2xl text-accent-50 sm:text-3xl">
            Sabato Morais Digital Repository
        </h2>
        <p class="mx-auto mt-3 max-w-xl font-body text-base leading-relaxed text-accent-50/75">
            Digitizing and preserving the correspondence, sermons, and manuscripts of
            Rev. Sabato Morais — hazzan of Congregation Mikveh Israel and founder of
            the Jewish Theological Seminary.
        </p>

        <nav class="mt-6">
            <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-sans text-xs uppercase tracking-widest">
                <li><a href="/" class="text-accent-50/80 transition hover:text-gold-soft">Browse</a></li>
                <li aria-hidden="true" class="text-gold-soft">&#10022;</li>
                <li><a href="/about" class="text-accent-50/80 transition hover:text-gold-soft">About</a></li>
                <li aria-hidden="true" class="text-gold-soft">&#10022;</li>
                <li><a href="https://judaicadhpenn.org/" class="text-accent-50/80 transition hover:text-gold-soft">Judaica DH at Penn</a></li>
            </ul>
        </nav>

        <div class="mx-auto mt-10 max-w-2xl border-t border-accent-50/15 pt-6">
            <a href="https://judaicadhpenn.org/" class="inline-block transition-opacity hover:opacity-80">
                <img
                    src="https://www.kaplancollection.org/_astro/Judaica%20Digital%20Humanities%20Logo%202020_RGB.BzHwUiEX.png"
                    alt="Judaica Digital Humanities"
                    class="mx-auto h-12 w-auto object-contain brightness-0 invert"
                    loading="lazy"
                />
            </a>
            <p class="mt-4 font-sans text-xs tracking-wide text-accent-50/50">
                &copy; 2026 Judaica Digital Humanities.
            </p>
        </div>
    </div>
</footer>

---
// A monogram roundel for Sabato Morais — the site's signature brand mark.
const { size = 72 } = Astro.props;
---
<span
  class="emblem"
  style={`--emblem-size:${size}px`}
  aria-hidden="true"
>
  <span class="emblem-inner">
    <span class="emblem-mono">S<span class="emblem-dot">&middot;</span>M</span>
  </span>
</span>

<style>
  .emblem {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--emblem-size, 72px);
    height: var(--emblem-size, 72px);
    border-radius: 9999px;
    border: 1px solid var(--color-gold-soft);
    background:
      radial-gradient(circle at 50% 38%, #ffffff 0%, var(--color-card) 70%);
    box-shadow: inset 0 0 0 3px var(--color-card), inset 0 0 0 4px var(--color-gold-soft);
  }
  .emblem-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 78%;
    height: 78%;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-navy) 30%, transparent);
  }
  .emblem-mono {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: calc(var(--emblem-size, 72px) * 0.42);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-navy);
  }
  .emblem-dot {
    color: var(--color-burgundy);
    padding: 0 0.02em;
  }
</style>

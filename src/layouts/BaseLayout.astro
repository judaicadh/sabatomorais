---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Sabato Morais Digital Repository",
  description = "The correspondence, sermons, and writings of Rev. Sabato Morais.",
  ogImage,
  ogType = "website",
  headGraph,
} = Astro.props;

const fullTitle =
  title === "Sabato Morais Digital Repository"
    ? title
    : `${title} — Sabato Morais Digital Repository`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content="Astro" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {headGraph && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@graph": headGraph,
            })}
        />
    )}
</head>
<body class="min-h-screen bg-paper text-ink font-body">
<NavBar />
<main class="relative flex-1 min-h-[60vh] z-10">
    <slot />
</main>
<Footer />
</body>
</html>

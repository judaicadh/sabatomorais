---
import BaseLayout from "../layouts/BaseLayout.astro";
import items from "../data/items.json";
import { slugify } from "../scripts/slugify.js";

const toArray = (v) => (Array.isArray(v) ? v : v ? [v] : []);

const cards = items
  .map((item) => {
    const preferred = item.slug || item.id || item.title;
    const slug = preferred ? slugify(String(preferred)) : null;
    if (!slug) return null;
    return {
      slug,
      title: item.title2 || item.title || "Untitled",
      description: item.description || "",
      type: item.type || "Item",
      date: toArray(item.date)[0] || "",
      thumbnail: item.thumbnail || "",
      subjects: toArray(item.subject).slice(0, 3),
    };
  })
  .filter(Boolean);
---

<BaseLayout>
  <!-- Hero -->
  <section class="border-b border-border bg-paper-light">
    <div class="mx-auto max-w-screen-xl px-4 py-16 sm:py-20 lg:py-24">
      <p class="mb-3 font-sans text-sm uppercase tracking-widest text-primary">
        Judaica Digital Humanities at Penn
      </p>
      <h1 class="max-w-3xl text-4xl font-serif leading-tight text-ink sm:text-5xl lg:text-6xl">
        The Sabato Morais Digital Repository
      </h1>
      <p class="mt-6 max-w-2xl font-body text-lg leading-relaxed text-ink-muted">
        Read, search, and study the correspondence, sermons, and manuscripts of
        Rev. Sabato Morais (1823–1897) — hazzan of Congregation Mikveh Israel and
        founder of the Jewish Theological Seminary. Each item pairs a searchable
        transcription with high-resolution page images.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#collection" class="rounded-md bg-primary px-5 py-2.5 font-sans text-sm font-medium text-white transition hover:opacity-90">
          Browse the collection
        </a>
        <a href="/about" class="rounded-md border border-border px-5 py-2.5 font-sans text-sm font-medium text-ink transition hover:bg-card">
          About Sabato Morais
        </a>
      </div>
    </div>
  </section>

  <!-- Collection grid -->
  <section id="collection" class="mx-auto max-w-screen-xl px-4 py-14">
    <div class="mb-8 flex items-baseline justify-between">
      <h2 class="text-2xl font-serif text-ink sm:text-3xl">Collection</h2>
      <span class="font-sans text-sm text-ink-muted">{cards.length} items</span>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((c) => (
        <a
          href={`/item/${c.slug}`}
          class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition hover:shadow-md"
        >
          <div class="aspect-[4/3] w-full overflow-hidden bg-paper-dark">
            {c.thumbnail ? (
              <img
                src={c.thumbnail}
                alt={c.title}
                class="h-full w-full object-cover transition group-hover:scale-[1.02]"
                loading="lazy"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center text-ink-muted/50">
                <svg viewBox="0 0 24 24" class="h-12 w-12" fill="none" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16v14H4z M4 15l4-4 4 4 4-4 4 4" />
                </svg>
              </div>
            )}
          </div>
          <div class="flex flex-1 flex-col p-4">
            <div class="mb-2 flex items-center gap-2 font-sans text-xs text-ink-muted">
              <span class="rounded bg-accent-100 px-2 py-0.5 text-ink">{c.type}</span>
              {c.date && <span>{c.date}</span>}
            </div>
            <h3 class="mb-1 font-serif text-lg leading-snug text-ink group-hover:text-accent-700">
              {c.title}
            </h3>
            <p class="line-clamp-3 flex-1 font-body text-sm text-ink-muted">
              {c.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

---
const links = [
    { href: "/", label: "Browse" },
    { href: "/about", label: "About Sabato Morais" },
    { href: "/about#repository", label: "The Repository" },
];
---

<!-- Navy top band -->
<div class="h-1.5 w-full bg-navy"></div>

<header class="border-b border-border bg-paper-light">
    <div class="mx-auto max-w-screen-xl px-4 py-7 text-center">
        <p class="eyebrow mb-3">Judaica Digital Humanities at Penn</p>

        <a href="/" class="inline-block">
            <h1 class="font-heading text-3xl leading-none text-navy sm:text-4xl md:text-5xl">
                Sabato Morais
            </h1>
            <p class="mt-1 font-heading text-base italic text-burgundy sm:text-lg">
                Digital Repository
            </p>
        </a>

        <div class="ornament mx-auto mt-5 max-w-md">
            <span class="ornament-mark">&#10087;</span>
        </div>

        <!-- Navigation -->
        <nav class="mt-4">
            <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-sans text-sm">
                {links.map((link, i) => (
                    <>
                        {i > 0 && <li aria-hidden="true" class="text-gold-soft">&#10022;</li>}
                        <li>
                            <a
                                href={link.href}
                                class="uppercase tracking-widest text-navy/80 transition-colors hover:text-burgundy"
                            >
                                {link.label}
                            </a>
                        </li>
                    </>
                ))}
            </ul>
        </nav>
    </div>
</header>

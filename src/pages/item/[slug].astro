---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Clover from "../../components/Clover";
import TEILoader from "../../components/TEILoader";
import Motif from "../../components/Motif.astro";
import items from "../../data/items.json";
import { slugify } from "../../scripts/slugify.js";

// ---------- helpers ----------
const formatItalics = (str) =>
  str ? str.replace(/\*(.*?)\*/g, "<i>$1</i>") : str;

const toArray = (v) => (Array.isArray(v) ? v : v ? [v] : []);

const normalizeNames = (...fields) => [
  ...new Set(
    fields
      .flatMap(toArray)
      .filter(Boolean)
      .flatMap((n) => String(n).split("|").map((s) => s.trim()))
      .filter(Boolean),
  ),
];

const toNames = (...vals) =>
  vals
    .flatMap(toArray)
    .filter(Boolean)
    .map((x) => (typeof x === "string" ? x : x?.name))
    .filter(Boolean);

const getSchemaType = (type) => {
  switch ((type || "").toLowerCase()) {
    case "letter":
      return "Message";
    case "book":
      return "Book";
    case "manuscript":
      return "Manuscript";
    case "sermon":
      return "CreativeWork";
    default:
      return "CreativeWork";
  }
};

function normalizePersonName(name) {
  if (!name) return "";
  name = name.trim();
  if (name.includes(",")) {
    const parts = name.split(",");
    const last = parts[0].trim();
    const rest = parts.slice(1).join(",").trim();
    return rest ? `${rest} ${last}` : last;
  }
  return name;
}

export async function getStaticPaths() {
  return items
    .map((item) => {
      const preferred = item.slug || item.id || item.title;
      const s = preferred ? slugify(String(preferred)) : null;
      return s ? { params: { slug: s } } : null;
    })
    .filter(Boolean);
}

const { slug } = Astro.params;

const itemData = items.find((item) => {
  const candidate = item.slug || item.id || item.title;
  return candidate && slugify(String(candidate)) === slug;
});

if (!itemData) {
  return new Response("Not Found", { status: 404 });
}

const manifestUrl = Array.isArray(itemData.manifestUrl)
  ? itemData.manifestUrl.find(Boolean) || ""
  : itemData.manifestUrl || "";

const rawContributors = itemData.contributors || itemData["dcterms:contributor"];
const uniqueNames = normalizeNames(itemData.creators, rawContributors);

const subjects = toNames(itemData.subject);
const languages = toArray(itemData.language || itemData["dcterms:language"]);

const CANON = "https://morais.judaicadhpenn.org";
const itemUrl = `${CANON}/item/${slug}`;

const authors = uniqueNames.map((n) => ({ "@type": "Person", name: n }));

const itemNode = {
  "@type": getSchemaType(itemData.type || "CreativeWork"),
  "@id": `${itemUrl}#item`,
  name: itemData.title2 || itemData.title || "Untitled",
  description: itemData.description || "No description available.",
  url: itemUrl,
  mainEntityOfPage: itemUrl,
  ...(itemData.thumbnail
    ? { image: [itemData.thumbnail], thumbnailUrl: itemData.thumbnail }
    : {}),
  ...(authors.length ? { author: authors } : {}),
  ...(subjects.length ? { keywords: subjects } : {}),
  dateCreated: toArray(itemData.date)[0],
  inLanguage: languages[0] || "en",
  identifier: itemData.id,
};

const title = itemData.title2 || itemData.title || "Untitled";
const dates = toArray(itemData.date);
const dateDisplay = itemData.dateDisplay || dates[0] || "";
const fromPlaces = toNames(itemData.fromLocation);
const toPlaces = toNames(itemData.toLocation);
const hasRecipient = toNames(rawContributors).length > 0;
const isLetter = (itemData.type || "").toLowerCase() === "letter" && hasRecipient;
---

<BaseLayout
  title={title}
  description={itemData.description || ""}
  ogImage={itemData.thumbnail}
  ogType="article"
  headGraph={[itemNode]}
>
  <section class="bg-paper py-8 antialiased sm:py-10 lg:py-12">
    <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8 text-center font-sans text-xs uppercase tracking-widest text-ink-muted">
        <ol class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
          <li><a href="/" class="transition hover:text-burgundy">Home</a></li>
          <li aria-hidden="true" class="text-gold-soft">&#10022;</li>
          <li><a href="/" class="transition hover:text-burgundy">Browse</a></li>
        </ol>
      </nav>

      <div class="mx-auto mb-10 max-w-4xl text-center">
        <p class="eyebrow mb-3">
          {itemData.type || "Item"}{dates[0] ? ` · ${dates[0]}` : ""}
        </p>
        <h1 class="font-heading text-3xl leading-tight text-navy sm:text-4xl lg:text-5xl">
          <span set:html={formatItalics(title)} />
        </h1>
        <div class="ornament mx-auto mt-6 max-w-md">
          <Motif class="text-gold" size={20} />
        </div>
      </div>

      <!-- Viewer / transcription area -->
      <div class="mx-auto mb-14 grid max-w-screen-2xl grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10">
        <div class="frame-gold flex flex-col overflow-hidden rounded-sm bg-paper-light">
          <div class="flex items-center justify-center border-b border-border bg-navy py-2">
            <span class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-gold-soft">
              Transcription
            </span>
          </div>
          {itemData.xml && (
            <p class="border-b border-border bg-paper-light px-5 py-2 text-center font-sans text-xs leading-relaxed text-ink-muted">
              Some transcriptions were generated with AI assistance and may contain
              errors. <a href="/methodology" class="text-burgundy underline">See methodology</a>.
            </p>
          )}
          <div class="h-[55vh] max-h-[42rem] min-h-[22rem] overflow-y-auto p-5 md:h-[60vh] lg:h-[72vh]">
            {itemData.xml ? (
              <TEILoader client:only="react" url={itemData.xml} />
            ) : (
              <div class="flex h-full items-center justify-center text-center font-body text-ink-muted">
                No transcription available
              </div>
            )}
          </div>
        </div>

        <div class="frame-gold flex flex-col overflow-hidden rounded-sm bg-paper-light">
          <div class="flex items-center justify-center border-b border-border bg-navy py-2">
            <span class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-gold-soft">
              Facsimile
            </span>
          </div>
          <div class="min-h-[22rem] p-2">
            {manifestUrl ? (
              <Clover client:only="react" manifest={manifestUrl} />
            ) : (
              <div class="flex h-full items-center justify-center text-center font-body text-ink-muted">
                No image available
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Metadata -->
      <div class="gilt-top mx-auto max-w-screen-2xl pt-10">
        <div class="mb-10 text-center">
          <p class="eyebrow mb-2">Catalogue Record</p>
          <h2 class="font-heading text-2xl text-navy sm:text-3xl">
            <span set:html={formatItalics(title)} />
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-8 text-gray-900 dark:text-gray-100 md:grid-cols-3 lg:gap-10">
          <div class="space-y-8 md:col-span-2">
            <section>
              <h3 class="mb-2 text-lg font-heading text-navy dark:text-gray-100">Description</h3>
              <p class="font-sans leading-relaxed text-ink dark:text-gray-300">
                {itemData.description || "No description available."}
              </p>
            </section>

            <section>
              <h3 class="mb-3 text-lg font-heading text-navy dark:text-gray-100">Subjects</h3>
              {subjects.length > 0 ? (
                <div class="flex flex-wrap gap-2">
                  {subjects.map((s) => (
                    <span class="rounded-full bg-accent-100 px-3 py-1 text-xs font-medium text-ink dark:bg-gray-700 dark:text-gray-100">
                      {s}
                    </span>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-gray-500 dark:text-gray-400">No subjects listed.</p>
              )}
            </section>

            <section>
              <h3 class="mb-3 text-lg font-heading text-navy dark:text-gray-100">Other Details</h3>
              <div class="space-y-2">
                <p class="text-sm text-ink dark:text-gray-100">
                  <span class="font-sans text-gray-500 dark:text-gray-400">Type:</span> {itemData.type || "Unknown"}
                </p>
                <p class="break-all text-sm text-ink dark:text-gray-100">
                  <span class="font-sans text-gray-500 dark:text-gray-400">Identifier:</span> {itemData.id || "Unknown"}
                </p>
                {itemData.collection && (
                  <p class="text-sm text-ink dark:text-gray-100">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Collection:</span> {itemData.collection}
                  </p>
                )}
                {itemData.callNumber && (
                  <p class="text-sm text-ink dark:text-gray-100">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Call number:</span> {itemData.callNumber}
                  </p>
                )}
                {itemData.extent && (
                  <p class="text-sm text-ink dark:text-gray-100">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Extent:</span> {itemData.extent}
                  </p>
                )}
                {itemData.rights && (
                  <p class="text-sm text-ink dark:text-gray-100">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Rights:</span>{" "}
                    {itemData.rightsUri ? (
                      <a href={itemData.rightsUri} class="underline hover:text-accent-700 dark:hover:text-accent-200">{itemData.rights}</a>
                    ) : (
                      itemData.rights
                    )}
                  </p>
                )}
                {(itemData.catalogUrl || itemData.apothecaUrl) && (
                  <p class="text-sm text-ink dark:text-gray-100">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Source record:</span>{" "}
                    {itemData.catalogUrl && (
                      <a href={itemData.catalogUrl} class="underline hover:text-accent-700 dark:hover:text-accent-200">Library catalog</a>
                    )}
                    {itemData.catalogUrl && itemData.apothecaUrl && " · "}
                    {itemData.apothecaUrl && (
                      <a href={itemData.apothecaUrl} class="underline hover:text-accent-700 dark:hover:text-accent-200">Apotheca</a>
                    )}
                  </p>
                )}
              </div>
            </section>
          </div>

          <div class="space-y-8">
            <section>
              <h3 class="mb-3 text-lg font-heading text-navy dark:text-gray-100">People</h3>
              {isLetter ? (
                <div class="space-y-3">
                  <p class="text-sm leading-relaxed">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Sender:</span>{" "}
                    {toNames(itemData.creators).map(normalizePersonName).join(", ") || "—"}
                  </p>
                  <p class="text-sm leading-relaxed">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Recipient:</span>{" "}
                    {toNames(rawContributors).map(normalizePersonName).join(", ") || "—"}
                  </p>
                </div>
              ) : (
                <p class="text-sm leading-relaxed">
                  <span class="font-sans text-gray-500 dark:text-gray-400">People:</span>{" "}
                  {uniqueNames.map(normalizePersonName).join(", ") || "—"}
                </p>
              )}
            </section>

            <section>
              <h3 class="mb-3 text-lg font-heading text-navy dark:text-gray-100">Dates</h3>
              <div class="space-y-2">
                <p class="text-sm text-ink dark:text-gray-100">
                  <span class="font-sans text-gray-500 dark:text-gray-400">Date:</span> {dateDisplay || "Unknown"}
                </p>
                {itemData.hebrewdate && (
                  <p class="text-sm text-ink dark:text-gray-100">
                    <span class="font-sans text-gray-500 dark:text-gray-400">Hebrew:</span> {itemData.hebrewdate}
                  </p>
                )}
              </div>
            </section>

            {(fromPlaces.length > 0 || toPlaces.length > 0) && (
              <section>
                <h3 class="mb-3 text-lg font-heading text-navy dark:text-gray-100">Places</h3>
                <div class="space-y-2">
                  {fromPlaces.length > 0 && (
                    <p class="text-sm leading-relaxed">
                      <span class="font-sans text-gray-500 dark:text-gray-400">From:</span> {fromPlaces.join(", ")}
                    </p>
                  )}
                  {toPlaces.length > 0 && (
                    <p class="text-sm leading-relaxed">
                      <span class="font-sans text-gray-500 dark:text-gray-400">To:</span> {toPlaces.join(", ")}
                    </p>
                  )}
                </div>
              </section>
            )}

            <section>
              <h3 class="mb-3 text-lg font-heading text-navy dark:text-gray-100">
                {languages.length > 1 ? "Languages" : "Language"}
              </h3>
              {languages.length > 0 ? (
                <div class="flex flex-wrap gap-2">
                  {languages.map((lang) => (
                    <span class="rounded-md bg-neutral-100 px-2 py-1 text-sm text-ink dark:bg-neutral-800 dark:text-gray-300">
                      {lang}
                    </span>
                  ))}
                </div>
              ) : (
                <span class="text-sm text-gray-500 dark:text-gray-400">Unknown</span>
              )}
            </section>
          </div>
        </div>
      </div>

      <!-- Citation -->
      <div class="mx-auto mt-14 max-w-screen-2xl gilt-top pt-10 text-center">
        <p class="eyebrow mb-2">How to Cite</p>
        <h2 class="mb-6 font-heading text-2xl text-navy">Citation</h2>
        <div class="mx-auto max-w-3xl overflow-x-auto rounded-sm border border-border bg-paper-light p-6 text-left font-body text-base leading-relaxed text-ink">
          {uniqueNames.length > 0 && <span>{uniqueNames.join(", ")}. </span>}
          “<span set:html={formatItalics(itemData.title || title)} />.”
          {dates[0] && <span> ({dates[0]}).</span>}{" "}
          {itemData.collection && <span>{itemData.collection}. </span>}
          Accessed at{" "}
          <a href={itemUrl} class="break-all underline hover:text-accent-700 dark:hover:text-accent-200">{itemUrl}</a>.
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
